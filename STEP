# Local Development (MacOS, Windows)
git tag v1.0.0  # 编译 master 分支需要 tag 临时绕过 git describe --tags 报错

yarn

yarn run watch  # yarn run build

yarn run start  # RUST_LOG=trace

yarn run lint   # code style check



# MacOS Release from local build
ARCH=arm64 node scripts/prepackage-plugins.mjs

ARCH=arm64 node scripts/build-macos.mjs

codesign --deep --force --sign - dist/mac-arm64/Tabby.app

codesign -dv --verbose=4 dist/mac-arm64/Tabby.app


# Windows Release from local build
> https://visualstudio.microsoft.com/zh-hans/vs/older-downloads/
Visual Studio 2022

ARCH=x64 node scripts/prepackage-plugins.mjs

ARCH=x64 node scripts/build-windows.mjs


# MacOS Release from Github Action (.dmg)
System settings... -> Privacy & Security -> "Tabby" was blocked to protect your Mac. -> Open Anyway


# download from CI
xattr -r -d com.apple.quarantine Tabby.app


