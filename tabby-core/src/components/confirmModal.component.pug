.confirm-surface
    .confirm-icon(aria-hidden='true')
        svg(viewBox='0 0 96 84', role='img')
            defs
                linearGradient#confirm-warning-gradient(x1='0', y1='0', x2='0', y2='1')
                    stop(offset='0', stop-color='#ffdd2e')
                    stop(offset='0.58', stop-color='#ffc20f')
                    stop(offset='1', stop-color='#f2a900')
                filter#confirm-warning-shadow(x='-20%', y='-20%', width='140%', height='150%')
                    feDropShadow(dx='0', dy='2', stdDeviation='1.4', flood-color='#000000', flood-opacity='0.22')
            path.warning-outline(
                d='M48 5.5 C51.8 5.5 55.1 7.5 57.1 11 L89.1 66.5 C91.1 70 91.1 74 89.2 77.1 C87.2 80.4 83.7 82.2 79.8 82.2 L16.2 82.2 C12.3 82.2 8.8 80.4 6.8 77.1 C4.9 74 4.9 70 6.9 66.5 L38.9 11 C40.9 7.5 44.2 5.5 48 5.5 Z',
                filter='url(#confirm-warning-shadow)'
            )
            path.warning-fill(
                d='M48 12.5 C49.3 12.5 50.5 13.3 51.3 14.6 L83.3 70.1 C84 71.4 84 72.8 83.3 73.9 C82.6 75.1 81.3 75.8 79.8 75.8 L16.2 75.8 C14.7 75.8 13.4 75.1 12.7 73.9 C12 72.8 12 71.4 12.7 70.1 L44.7 14.6 C45.5 13.3 46.7 12.5 48 12.5 Z'
            )
            rect.warning-stem(x='43.8', y='29', width='8.4', height='28', rx='4.2')
            circle.warning-dot(cx='48', cy='64.5', r='4.4')

    .confirm-message {{message}}
    .confirm-detail(*ngIf='detail') {{detail}}

    .confirm-actions
        button.btn.confirm-button.confirm-cancel((click)='cancel()') {{cancelButton}}
        button.btn.confirm-button.confirm-primary([ngClass]='confirmClass', (click)='confirm()') {{confirmButton}}
