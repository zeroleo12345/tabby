.modal-body
    .mb-2
        label.form-label.mb-1 {{ usernamePrompt }}
        input.form-control(
            type='text',
            [(ngModel)]='username',
            #usernameInput,
            (keyup.enter)='ok()',
            (keyup.esc)='cancel()',
        )
    .mb-2
        label.form-label.mb-1 {{ passwordPrompt }}
        input.form-control(
            type='password',
            [(ngModel)]='password',
            #passwordInput,
            (keyup.enter)='ok()',
            (keyup.esc)='cancel()',
        )
    .d-flex.align-items-start.mt-2
        checkbox(
            *ngIf='showRememberCheckbox',
            [(ngModel)]='remember',
            text='Remember'
        )
        button.btn.btn-primary.ms-auto(
            (click)='ok()',
        ) OK
